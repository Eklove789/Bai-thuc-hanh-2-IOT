# Sao chep thanh .env roi doi mat khau / token truoc khi chay

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=iot/+/+/telemetry

# InfluxDB
INFLUX_URL=http://localhost:8086
INFLUX_USERNAME=admin
INFLUX_PASSWORD=change-me-123
INFLUX_ORG=ptit
INFLUX_TOKEN=change-me-token
INFLUX_BUCKET_RAW=iot_raw
INFLUX_RETENTION_RAW=7d
INFLUX_BUCKET_CLEAN=iot_clean
INFLUX_RETENTION_CLEAN_DAYS=30

# Grafana
GRAFANA_PASSWORD=change-me-123
